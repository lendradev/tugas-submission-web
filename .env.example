# Konfigurasi Tugas Submission

Salin berkas ini menjadi `.env` lalu isi nilainya. Jangan pernah commit `.env`.

# Server
TS_ADDR=127.0.0.1:8080
TS_DATA_DIR=./data
TS_SESSION_TTL_HOURS=168
TS_TRUSTED_PROXY=false

# Repository target (wajib agar sinkronisasi berjalan)
TS_REPO_OWNER=username-owner
TS_REPO_NAME=nama-repository
TS_REPO_BRANCH=main

# Fine-grained PAT: Contents read & write pada repository di atas.
TS_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Endpoint API. Kosongkan untuk GitHub.com.
TS_GITHUB_API=https://api.github.com

# Gunakan Contents API (Gitea / Forgejo) alih-alih Git Data API.
TS_GITEA_MODE=false

# Akun admin awal, hanya dipakai saat database masih kosong.
TS_ADMIN_USERNAME=admin
TS_ADMIN_PASSWORD=ganti-dengan-password-kuat

# TLS langsung (biasanya tidak perlu; pakai reverse proxy).
# TS_TLS_CERT=/path/ke/cert.pem
# TS_TLS_KEY=/path/ke/key.pem
